    "sliding_attention",
    "full_attention"
  ],
  "bos_token_id": 0,
  "pad_token_id": 2,
  "rms_norm_eps": 1e-06,
  "tie_word_embeddings": false,
  "use_valres": true,
  "use_gated_attention": true
}