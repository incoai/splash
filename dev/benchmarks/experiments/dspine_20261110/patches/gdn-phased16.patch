+// Research: peak shared lifetime is current Q/K/V/output, not the sum
+// of pending and current vectors. Phase1 uses queries/keys as pending K/V;
+// the whole threadgroup finishes the commit before Phase2 overwrites them.
+template <uint HeadDim> struct GdnPhasedShared {
+  bfloat queries[SPLASH_TARGET_VERIFY_ROWS * HeadDim];
+  bfloat keys[SPLASH_TARGET_VERIFY_ROWS * HeadDim];
+  bfloat values[SPLASH_TARGET_VERIFY_ROWS * HeadDim];
+  bfloat rows[SPLASH_TARGET_VERIFY_ROWS * HeadDim];
+};
+template <uint KeyHeads, uint ValueHeads, uint HeadDim>
+inline void gdn_load_pending_phased(GdnTape tape, uint pending,
+    threadgroup GdnPhasedShared<HeadDim> &shared, uint head, uint lane, uint token) {
+  constexpr uint KvWidth = (KeyHeads + ValueHeads) * HeadDim;
+  const uint key = head / (ValueHeads / KeyHeads) * HeadDim;
+  const uint value = KeyHeads * HeadDim + head * HeadDim;
+  if (token < pending) for (uint g = 0; g < HeadDim / 32; ++g) {
+    const uint dim = 32 * g + lane;
+    shared.queries[token * HeadDim + dim] = tape.kv[token * KvWidth + key + dim];
+    shared.keys[token * HeadDim + dim] = tape.kv[token * KvWidth + value + dim];
+  }
+}
