@@ -197,3 +197,19 @@ kernel void dspine_refine_score(device const float *state [[buffer(0)]], device
     tokens[candidate_row] = candidates[candidate_row * K + choice];
   }
 }
+
+// Research candidate matching upstream DSpine bridge.py: the normalized
+// activation rounds to BF16 before multiplication by the learned gamma.
+#include "metal/kernels/common/rms_inverse.h"
+kernel void dspine_bridge_norm(device const bfloat *input [[buffer(0)]],
+    device const bfloat *weight [[buffer(1)]], device bfloat *output [[buffer(2)]],
+    constant uint &width [[buffer(3)]], uint row [[threadgroup_position_in_grid]],
+    uint tid [[thread_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]],
+    uint sg [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float reductions[8];
+  float inverse = rms_inverse(input + ulong(row) * width, width, reductions, tid, lane, sg);
+  for (uint h = tid; h < width; h += 256) {
+    bfloat y = bfloat(float(input[ulong(row) * width + h]) * inverse);
+    output[ulong(row) * width + h] = bfloat(float(y) * float(weight[h]));
+  }
+}
