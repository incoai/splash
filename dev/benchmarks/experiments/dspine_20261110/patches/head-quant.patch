+void loadResearchProposalHead(metal::MetalBackend &backend, WeightImages &images, DFlashDraftWeights &draft) {
+  const char *directory = std::getenv("SPLASH_DSPINE_HEAD_CHECKPOINT");
+  if (!directory || !*directory) return;
+  if (!draft.layout.isDSpine()) throw WeightStoreError("research proposal head requires DSpine");
+  const char *option = std::getenv("SPLASH_DSPINE_HEAD_BITS");
+  const std::string bitsText = option ? option : "3";
+  if (bitsText != "2" && bitsText != "3" && bitsText != "4" && bitsText != "6" && bitsText != "8")
+    throw WeightStoreError("research proposal head bits must be 2, 3, 4, 6 or 8");
+  const uint32_t bits = static_cast<uint32_t>(std::stoul(bitsText));
+  const uint32_t formatId = quant_affine_format_of(bits, 64);
+  const auto checkpoint = std::make_shared<SafetensorsCheckpoint>(directory);
+  const auto &tensor = checkpoint->require("lm_head.weight");
+  const uint32_t rows = draft.layout.vocabularySize, columns = draft.layout.hiddenSize;
+  if (tensor.dtype != "BF16" || tensor.shape != std::vector<uint64_t>{rows, columns})
+    throw WeightStoreError("research proposal head has the wrong type or shape");
+  gguf::ImageBuilder builder("proposal-head.bin", draft.layout.layers + 1, 2);
+  auto repack = builder.planes(formatId, rows, columns, "proposal-head");
+  repack.sources.push_back({"lm_head", kQuantFormats[formatId].ggml_type, 0, rows,
+      ggufRowBytes(kQuantFormats[formatId], columns), {}, tensor.file, {.bfloat16 = &tensor}});
+  builder.repack(std::move(repack));
+  const auto plan = std::make_shared<const gguf::Image>(builder.finish());
+  const auto before = backend.memoryStats().allocatedBytes;
+  auto file = loadImage(backend, images, "draft/", plan, [checkpoint] { checkpoint->checkUnchanged(); });
+  draft.proposalHead = readBlockProjection(file, rows, columns, "proposal-head");
+  draft.proposalHead.destination = ops::FloatOutput::Float32;
+  file.finish();
+  draft.files.push_back(file.record());
+  draft.actualAllocatedBytes += metal::allocationDelta(before, backend.memoryStats().allocatedBytes);
+}
