diff --git a/runtime/metal/kernels/shared/gguf_linear_rows.metal b/runtime/metal/kernels/shared/gguf_linear_rows.metal
new file mode 100644
index 00000000..6527afcf
--- /dev/null
+++ b/runtime/metal/kernels/shared/gguf_linear_rows.metal
@@ -0,0 +1,66 @@
+// Research AF4 decode: row SIMDgroups share one 64-column weight stage.
+// Keep the existing K walk, dequantization, split reduction and epilogues.
+#pragma clang fp reassociate(off)
+#include "metal/kernels/common/gguf_staged_tile.h"
+#include "metal/kernels/common/split_reduce.h"
+
+template <ushort Rows, ushort PartRows, GgufEpilogue Ep, class Out>
+kernel void gguf_decode_rows_shared(device bfloat *input [[buffer(0)]], device uchar *w0 [[buffer(1)]],
+    device uchar *w1 [[buffer(2)]], device uchar *meta [[buffer(3)]], device Out *output [[buffer(4)]],
+    device coherent(device) float *partials [[buffer(5)]], device atomic_uint *counters [[buffer(6)]],
+    device bfloat *aux [[buffer(7)]], constant GgufDecodeParams &p [[buffer(8)]],
+    uint2 group [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]],
+    uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  static_assert(Rows % PartRows == 0 && Rows > PartRows);
+  constexpr ushort Groups = Rows / PartRows;
+  constexpr ushort Columns = GGUF_TILE_COLUMNS, KS = GGUF_STAGED_STEP;
+  constexpr ushort Threads = Groups * 32;
+  threadgroup half stage[2 * Columns * KS];
+  threadgroup half2 tl[1];  // AF4 has no codebook.
+  threadgroup uint arrival;
+  const uint thread_index = simd_group * 32 + lane;
+  const uint row0 = simd_group * PartRows;
+  const uint origin = group.x * Columns, column0 = p.out_offset + origin;
+  const uint per = p.input_size / KS / p.splits, sb = group.y * per, se = sb + per;
+  device bfloat *mine = input + ulong(row0) * p.input_size;
+  auto acc = staged_accumulator<PartRows, Columns, KS>(mine, p.input_size, stage);
+  gguf_zero(acc);
+  gguf_staged_steps<FmtAF4G64, PartRows, Columns, KS, Threads>(mine, w0, w1, meta, p.input_size,
+      origin, stage, tl, thread_index, sb, se, staged_first_step(group.x, sb, se, p.spread), true, acc);
+  const auto out = [&](uint row, uint column, float value) {
+    const ulong at = ulong(row0 + row) * p.out_stride + column0 + column;
+    output[at] = gguf_epilogue<Ep, Out>(value, aux, at);
+  };
+  if (p.splits == 1) {
+    gguf_elements(acc, out);
+    return;
+  }
+  const auto at = [&](uint split, uint row, uint column) {
+    return (ulong(split) * Rows + row0 + row) * p.out_stride + column0 + column;
+  };
+  gguf_elements(acc, [&](uint row, uint column, float value) {
+    partials[at(group.y, row, column)] = value;
+  });
+  device atomic_uint *counter = counters + p.out_offset / Columns + group.x;
+  if (!split_arrive_last(counter, p.splits, thread_index, &arrival)) return;
+  gguf_elements(acc, [&](uint row, uint column, float value) {
+    out(row, column, split_sum(value, group.y, p.splits,
+        [&](uint split) { return partials[at(split, row, column)]; }));
+  });
+  split_release(counter, thread_index);
+}
+
+template <class Out>
+using GgufRowsSharedKernel = void(device bfloat *, device uchar *, device uchar *, device uchar *, device Out *,
+    device coherent(device) float *, device atomic_uint *, device bfloat *, constant GgufDecodeParams &, uint2, uint, uint);
+#define ROWS_SHARED(R, P, ep, Ep, Out) \
+  template [[host_name("gguf_decode_af4g64_m" #R "_" #ep "_rows" #P)]] \
+  kernel GgufRowsSharedKernel<Out> gguf_decode_rows_shared<R, P, Ep, Out>;
+#define ROWS_SHARED_EPILOGUES(R, P) \
+  ROWS_SHARED(R, P, a, EpNone, bfloat) ROWS_SHARED(R, P, a_f32, EpNone, float) \
+  ROWS_SHARED(R, P, r, EpResidual, bfloat) ROWS_SHARED(R, P, g, EpUpWithGate, bfloat)
+ROWS_SHARED_EPILOGUES(32, 16)
+ROWS_SHARED_EPILOGUES(64, 16)
+ROWS_SHARED_EPILOGUES(64, 32)
+#undef ROWS_SHARED_EPILOGUES
+#undef ROWS_SHARED
