   "rtf": 0.29377803492271154,
   "id": "en_long_01",
   "lang": "en",
   "length": "long",
   "units": 83,
   "text": "The lighthouse keeper had lived alone on the island for nearly twenty years, and in all that time he had never once missed lighting the lamp at dusk. Supply boats came twice a month, bringing flour, lamp oil, newspapers, and the occasional letter from his sister on the mainland. He read every page slowly, savoring the news of a world that seemed to grow more distant with each passing season, then folded the papers neatly and stacked them beside the stove for kindling."
  },
  {
   "ttfa_s": 0.04997666602139361,
   "total_s": 11.22737475001486,
   "audio_s": 38.32,
   "sample_rate": 24000,
   "num_bytes": 1839360,
