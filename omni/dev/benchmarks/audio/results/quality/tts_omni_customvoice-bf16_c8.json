   "error": null,
   "extra": {
    "start_offset_s": 5.469094291009242
   },
   "rtf": 0.2921415965227196,
   "id": "en_long_05",
   "lang": "en",
   "length": "long",
   "units": 84,
   "text": "On the first morning of the hike, the trail climbed steadily through a forest of tall pines whose needles muffled every footstep. By midday the trees thinned out and gave way to open meadows dotted with wildflowers, and the wind carried the faint sound of cowbells from a distant pasture. We stopped beside a cold stream to refill our bottles and eat bread and cheese, then pushed on toward the ridge, where the view stretched all the way to the glaciers in the north."
  },
  {
   "ttfa_s": 0.04945308298920281,
   "total_s": 13.711450749979122,
   "audio_s": 45.84,
   "sample_rate": 24000,
   "num_bytes": 2200320,
   "num_chunks": 551,
   "audio_path": "bench-audio/tts_omni_customvoice-bf16_c8/en_long_06.wav",
   "status": 200,
