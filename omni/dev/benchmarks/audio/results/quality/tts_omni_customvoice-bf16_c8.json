    "start_offset_s": 4.702529208007036
   },
   "rtf": 0.29298994650351934,
   "id": "en_long_02",
   "lang": "en",
   "length": "long",
   "units": 82,
   "text": "Learning to cook well is mostly a matter of patience and attention. Begin with a few simple dishes and repeat them until the steps feel natural, paying close attention to how the onions change color as they soften and how the sauce thickens as it reduces. Taste constantly and adjust the salt in small amounts. Over time you will stop measuring everything and begin to trust your senses, which is exactly when cooking stops feeling like work and starts feeling like play."
  },
  {
   "ttfa_s": 0.07679454199387692,
   "total_s": 11.153390999999829,
   "audio_s": 38.16,
   "sample_rate": 24000,
