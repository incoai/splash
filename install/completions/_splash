#compdef splash

# Keep the stable install path so an already-running shell survives upgrades.
typeset -g _splash_completion_source=${${(%):-%x}:a}

_splash() {
    local word helper
    local -a models
    if (( CURRENT == 2 )); then
        compadd -- serve download-draft claude codex opencode hermes pi
        return
    fi
    [[ $words[2] == serve || $words[2] == download-draft ]] || return 0
    for word in "${words[@]:2:$(( CURRENT - 3 ))}"; do
        [[ $word == -- ]] && return 0
    done
    if [[ $words[CURRENT-1] == --model-dir || $words[CURRENT] == --model-dir=* ]]; then
        [[ $words[CURRENT] == --model-dir=* ]] && compset -P '--model-dir='
        _files -/
        return
    fi
    if [[ $words[CURRENT] == --* && $words[CURRENT] != --model=* ]]; then
        local -a options=(--model --model-dir --revision --draft-model)
        [[ $words[2] == serve ]] && options+=(--download-draft)
        compadd -- "${options[@]}"
        return
    fi
    if [[ $words[CURRENT-1] == --model ]]; then
        :
    elif [[ $words[CURRENT] == --model=* ]]; then
        compset -P '--model='
    else
        return 0
    fi
    helper="${_splash_completion_source:A:h}/models"
    [[ -x $helper ]] || return 0
    models=(${(f)"$("$helper" "$PREFIX")"})
    (( ${#models} )) && compadd -- "${models[@]}"
    return 0
}

if [[ $zsh_eval_context[-1] == loadautofunc ]]; then
    _splash "$@"
elif (( $+functions[compdef] )); then
    compdef _splash splash
fi
